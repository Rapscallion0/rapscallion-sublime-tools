[
    {
        "caption": "Raps: Tools - Settings",
        "command": "edit_settings",
        "args": {
            "base_file": "${packages}/RapscallionTools/RapscallionTools.sublime-settings",
            "default": "{\n\t$0\n}\n"
        }
    },
    {
        "caption": "Raps: Tools - Key Bindings",
        "command": "edit_settings",
        "args": {
            "base_file": "${packages}/RapscallionTools/Default ($platform).sublime-keymap",
            "default": "[\n\t$0\n]\n"
        }
    },
    {
        "caption": "Raps: Tools - Toggle Status Bar Info",
        "command": "rapscallion_toggle_status_bar"
    },
    {
        "caption": "Raps: Tools - Show Status Bar Info Details",
        "command": "rapscallion_show_status_details"
    },
    {
        "caption": "Raps: Tools - Decode Hex Characters (In Place)",
        "command": "rapscallion_decode_hex",
        "args": { "to_new_tab": false, "pattern": "brace" }
    },
    {
        "caption": "Raps: Tools - Decode Hex Characters (To New Tab)",
        "command": "rapscallion_decode_hex",
        "args": { "to_new_tab": true, "pattern": "brace" }
    },
    {
        "caption": "Raps: Tools - Decode Hex Characters (All Formats - In Place)",
        "command": "rapscallion_decode_hex",
        "args": { "to_new_tab": false, "pattern": "all" }
    },
    {
        "caption": "Raps: Tools - Decode Hex Characters (All Formats - To New Tab)",
        "command": "rapscallion_decode_hex",
        "args": { "to_new_tab": true, "pattern": "all" }
    },
    {
        "caption": "Raps: Tools - Insert Timestamp",
        "command": "insert_timestamp"
    },
    {
        "caption": "Raps: Tools - Jump to First Match",
        "command": "jump_to_first_match"
    },
    {
        "caption": "Raps: Tools - Jump to Matching XML Tag",
        "command": "jump_xml_tag"
    },
    {
        "caption": "Raps: Tools - Restore Folder Session",
        "command": "restore_folder_session"
    }
