[
    {
        "caption": "Preferences: Rapscallion Tools Settings",
        "command": "edit_settings",
        "args": {
            "base_file": "${packages}/RapscallionTools/RapscallionTools.sublime-settings",
            "default": "{\n\t$0\n}\n"
        }
    },
    {
        "caption": "Preferences: Rapscallion Tools Key Bindings",
        "command": "edit_settings",
        "args": {
            "base_file": "${packages}/RapscallionTools/Default ($platform).sublime-keymap",
            "default": "[\n\t$0\n]\n"
        }
    },
    {
        "caption": "Rapscallion Tools: Toggle Status Bar Info",
        "command": "rapscallion_toggle_status_bar"
    },
    {
        "caption": "Rapscallion Tools: Show Status Bar Info Details",
        "command": "rapscallion_show_status_details"
    },
    {
        "caption": "Rapscallion Tools: Decode Hex Characters (In Place)",
        "command": "rapscallion_decode_hex",
        "args": { "to_new_tab": false, "pattern": "brace" }
    },
    {
        "caption": "Rapscallion Tools: Decode Hex Characters (To New Tab)",
        "command": "rapscallion_decode_hex",
        "args": { "to_new_tab": true, "pattern": "brace" }
    },
    {
        "caption": "Rapscallion Tools: Decode Hex Characters (All Formats - In Place)",
        "command": "rapscallion_decode_hex",
        "args": { "to_new_tab": false, "pattern": "all" }
    },
    {
        "caption": "Rapscallion Tools: Decode Hex Characters (All Formats - To New Tab)",
        "command": "rapscallion_decode_hex",
        "args": { "to_new_tab": true, "pattern": "all" }
    }
]
