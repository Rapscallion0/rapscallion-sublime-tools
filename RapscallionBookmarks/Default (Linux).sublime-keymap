[
    // =========================================================================
    // Rapscallion Bookmarks: Direct Legacy Shortcuts (Preserved)
    // =========================================================================
    {
        "keys": ["alt+b"],
        "command": "rapscallion_quick_bookmarks"
    },
    {
        "keys": ["alt+shift+b"],
        "command": "rapscallion_toggle_panel"
    },
    {
        "keys": ["ctrl+f2"],
        "command": "rapscallion_toggle_bookmark",
        "context": [
            { "key": "setting.is_rapscallion_zip_view", "operator": "not_equal", "operand": true }
        ]
    },
    {
        "keys": ["ctrl+shift+f2"],
        "command": "rapscallion_set_named_bookmark",
        "context": [
            { "key": "setting.is_rapscallion_zip_view", "operator": "not_equal", "operand": true }
        ]
    },
    {
        "keys": ["f2"],
        "command": "rapscallion_next_bookmark",
        "context": [
            { "key": "setting.is_rapscallion_zip_view", "operator": "not_equal", "operand": true }
        ]
    },
    {
        "keys": ["shift+f2"],
        "command": "rapscallion_prev_bookmark",
        "context": [
            { "key": "setting.is_rapscallion_zip_view", "operator": "not_equal", "operand": true }
        ]
    },
    {
        "keys": ["alt+f2"],
        "command": "rapscallion_next_project_bookmark"
    },
    {
        "keys": ["alt+shift+f2"],
        "command": "rapscallion_prev_project_bookmark"
    },

    // Panel Navigation Context
    {
        "keys": ["enter"],
        "command": "rapscallion_panel_jump",
