        "command": "rapscallion_panel_rename",
        "context": [
            { "key": "setting.rapscallion_bookmarks_panel", "operator": "equal", "operand": true }
        ]
    },
    {
        "keys": ["t"],
        "command": "rapscallion_panel_set_tag",
        "context": [
            { "key": "setting.rapscallion_bookmarks_panel", "operator": "equal", "operand": true }
        ]
    },
    {
        "keys": ["f5"],
        "command": "rapscallion_refresh_panel",
        "context": [
            { "key": "setting.rapscallion_bookmarks_panel", "operator": "equal", "operand": true }
        ]
    },

    // =========================================================================
    // Rapscallion Bookmarks: Key Chords (Prefix: Ctrl+Alt+B)
    // =========================================================================

    // Toggle Bookmark: Ctrl+Alt+B, T
    {
        "keys": ["ctrl+alt+b", "t"],
        "command": "rapscallion_toggle_bookmark"
    },

    // Add Named Bookmark: Ctrl+Alt+B, N
    {
        "keys": ["ctrl+alt+b", "n"],
        "command": "rapscallion_set_named_bookmark"
    },

    // Quick Panel Navigator: Ctrl+Alt+B, Q
    {
        "keys": ["ctrl+alt+b", "q"],
        "command": "rapscallion_quick_bookmarks"
    },

    // Toggle Bottom Bookmarks Panel: Ctrl+Alt+B, P
    {
        "keys": ["ctrl+alt+b", "p"],
        "command": "rapscallion_toggle_panel"
    },

