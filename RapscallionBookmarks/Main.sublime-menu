[
    {
        "caption": "Preferences",
        "mnemonic": "n",
        "id": "preferences",
        "children": [
            {
                "caption": "Package Settings",
                "mnemonic": "P",
                "id": "package-settings",
                "children": [
                    {
                        "caption": "Rapscallion Tools",
                        "id": "rapscallion-tools",
                        "children": [
                            {
                                "caption": "Bookmarks",
                                "children": [
                                    {
                                        "caption": "Toggle Bookmark (Ctrl+F2)",
                                        "command": "rapscallion_toggle_bookmark"
                                    },
                                    {
                                        "caption": "Add Named Bookmark… (Ctrl+Shift+F2)",
                                        "command": "rapscallion_set_named_bookmark"
                                    },
                                    {
                                        "caption": "-"
                                    },
                                    {
                                        "caption": "Next Bookmark (F2)",
                                        "command": "rapscallion_next_bookmark"
                                    },
                                    {
                                        "caption": "Previous Bookmark (Shift+F2)",
                                        "command": "rapscallion_prev_bookmark"
                                    },
                                    {
                                        "caption": "-"
                                    },
                                    {
                                        "caption": "Quick Panel (Alt+B)",
                                        "command": "rapscallion_quick_bookmarks"
                                    },
                                    {
                                        "caption": "Toggle Bottom Panel (Alt+Shift+B)",
                                        "command": "rapscallion_toggle_panel"
                                    },
                                    {
                                        "caption": "Toggle Side Panel (Legacy)",
                                        "command": "rapscallion_toggle_side_panel"
                                    },
                                    {
                                        "caption": "-"
                                    },
                                    {
                                        "caption": "Clear Bookmarks in This File",
                                        "command": "rapscallion_clear_file_bookmarks"
                                    },
                                    {
                                        "caption": "Clear All Bookmarks in Project…",
                                        "command": "rapscallion_clear_all_bookmarks"
                                    },
                                    {
                                        "caption": "Export Bookmarks to Markdown",
                                        "command": "rapscallion_export_markdown"
                                    },
                                    {
                                        "caption": "-"
                                    },
                                    {
                                        "caption": "Settings",
                                        "command": "edit_settings",
                                        "args": {
                                            "base_file": "${packages}/RapscallionBookmarks/RapscallionBookmarks.sublime-settings",
                                            "default": "{\n    $0\n}\n"
                                        }
                                    },
                                    {
                                        "caption": "Key Bindings",
                                        "command": "edit_settings",
                                        "args": {
                                            "base_file": "${packages}/RapscallionBookmarks/Default ($platform).sublime-keymap",
                                            "default": "[\n    $0\n]\n"
                                        }
                                    }
                                ]
                            }
                        ]
                    }
                ]
            }
        ]
    }
]
