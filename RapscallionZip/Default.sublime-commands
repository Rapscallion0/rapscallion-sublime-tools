[
    {
        "caption": "Raps: Zip - Settings",
        "command": "edit_settings",
        "args": {
            "base_file": "${packages}/RapscallionZip/RapscallionZip.sublime-settings",
            "default": "{\n    $0\n}\n"
        }
    },
    {
        "caption": "Raps: Zip - Key Bindings",
        "command": "edit_settings",
        "args": {
            "base_file": "${packages}/RapscallionZip/Default ($platform).sublime-keymap",
            "default": "[\n    $0\n]\n"
        }
    },
    {
        "caption": "Raps: Zip - Mouse Bindings",
        "command": "edit_settings",
        "args": {
            "base_file": "${packages}/RapscallionZip/Default ($platform).sublime-mousemap",
            "default": "[\n    $0\n]\n"
        }
    },
    {
        "caption": "Raps: Zip - Clear Extracted Cache",
        "command": "rapscallion_clear_zip_cache"
    },
    {
        "caption": "Raps: Zip - Filter Current Archive Tree",
        "command": "rapscallion_filter_zip"
    },
    {
        "caption": "Raps: Zip - Extract Archive to Folder",
        "command": "rapscallion_extract_zip"
