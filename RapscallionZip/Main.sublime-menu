[
    {
        "caption": "Preferences",
        "mnemonic": "n",
        "id": "preferences",
        "children": [
            {
                "caption": "Package Settings",
                "mnemonic": "P",
                "id": "package-settings",
                "children": [
                    {
                        "caption": "Rapscallion Tools",
                        "id": "rapscallion-tools",
                        "children": [
                            {
                                "caption": "Archive Explorer (Zip)",
                                "children": [
                                    {
                                        "caption": "Settings",
                                        "command": "edit_settings",
                                        "args": {
                                            "base_file": "${packages}/RapscallionZip/RapscallionZip.sublime-settings",
                                            "default": "{\n    $0\n}\n"
                                        }
                                    },
                                    {
                                        "caption": "Key Bindings",
                                        "command": "edit_settings",
                                        "args": {
                                            "base_file": "${packages}/RapscallionZip/Default (Windows).sublime-keymap",
                                            "default": "[\n    $0\n]\n"
                                        }
                                    },
                                    {
                                        "caption": "Mouse Bindings",
                                        "command": "edit_settings",
                                        "args": {
                                            "base_file": "${packages}/RapscallionZip/Default (Windows).sublime-mousemap",
                                            "default": "[\n    $0\n]\n"
                                        }
                                    }
                                ]
                            }
                        ]
                    }
                ]
            }
        ]
    }
]