%YAML 1.2
---
name: SIL (Rainbow)
file_extensions:
  - sil
scope: text.rainbow.sil

contexts:
  main:
    # Comments
    - match: '(--|#).*$'
      scope: comment.line

    # Directives
    - match: '(?i)@(CREATE|UPDATE_BATCH|COMMIT|END)\b'
      scope: keyword.control.directive.sil

    # Header: Enter 10-column rainbow rotation after SELECT in CREATE VIEW
    - match: '(?i)\bSELECT\b'
      scope: keyword.other.sql
      push: col1_header

    # General SQL Scaffolding
    - match: '(?i)\b(CREATE\s+VIEW|AS|FROM|INSERT\s+INTO|VALUES|DROP\s+TABLE)\b'
      scope: keyword.other.sql

    # Data Rows: Enter 10-column rainbow rotation on '('
    - match: '^\s*\('
      scope: punctuation.section.sequence.begin
      push: col1

  # =============================================================
  # Header Column Rotation (Triggered inside SELECT ... FROM)
  # =============================================================

  col1_header:
    - match: ','
      scope: punctuation.separator.sequence
      set: col2_header
    - include: header_end
    - match: '[A-Za-z0-9_]+'
      scope: markup.rainbow1.sil markup.rainbow1 markup.deleted.sil

  col2_header:
    - match: ','
      scope: punctuation.separator.sequence
      set: col3_header
    - include: header_end
    - match: '[A-Za-z0-9_]+'
      scope: markup.rainbow2.sil markup.rainbow2 constant.numeric.sil

  col3_header:
    - match: ','
      scope: punctuation.separator.sequence
      set: col4_header
    - include: header_end
    - match: '[A-Za-z0-9_]+'
      scope: markup.rainbow3.sil markup.rainbow3 markup.inserted.sil string.quoted.double.sil

  col4_header:
    - match: ','
      scope: punctuation.separator.sequence
      set: col5_header
    - include: header_end
    - match: '[A-Za-z0-9_]+'
      scope: markup.rainbow4.sil markup.rainbow4 entity.name.function.sil

  col5_header:
    - match: ','
      scope: punctuation.separator.sequence
      set: col6_header
    - include: header_end
    - match: '[A-Za-z0-9_]+'
      scope: markup.rainbow5.sil markup.rainbow5 keyword.control.sil

  col6_header:
    - match: ','
      scope: punctuation.separator.sequence
      set: col7_header
    - include: header_end
    - match: '[A-Za-z0-9_]+'
      scope: markup.rainbow6.sil markup.rainbow6 variable.parameter.sil

  col7_header:
    - match: ','
      scope: punctuation.separator.sequence
      set: col8_header
    - include: header_end
    - match: '[A-Za-z0-9_]+'
      scope: markup.rainbow7.sil markup.rainbow7 support.type.sil

  col8_header:
    - match: ','
      scope: punctuation.separator.sequence
      set: col9_header
    - include: header_end
    - match: '[A-Za-z0-9_]+'
      scope: markup.rainbow8.sil markup.rainbow8 entity.other.attribute-name.sil

  col9_header:
    - match: ','
      scope: punctuation.separator.sequence
      set: col10_header
    - include: header_end
    - match: '[A-Za-z0-9_]+'
      scope: markup.rainbow9.sil markup.rainbow9 string.quoted.single.sil

  col10_header:
    - match: ','
      scope: punctuation.separator.sequence
      set: col1_header
    - include: header_end
    - match: '[A-Za-z0-9_]+'
      scope: markup.rainbow10.sil markup.rainbow10 punctuation.section.sil

  header_end:
    - match: '(?i)\bFROM\b'
      scope: keyword.other.sql
      pop: true
    - match: ';'
      scope: punctuation.terminator.statement
      pop: true

  # =============================================================
  # Data Row Column Rotation (Triggered inside '(' ... ')')
  # =============================================================

  col1:
    - match: ','
      scope: punctuation.separator.sequence
      set: col2
    - include: col_end
    - include: field_content_1

  col2:
    - match: ','
      scope: punctuation.separator.sequence
      set: col3
    - include: col_end
    - include: field_content_2

  col3:
    - match: ','
      scope: punctuation.separator.sequence
      set: col4
    - include: col_end
    - include: field_content_3

  col4:
    - match: ','
      scope: punctuation.separator.sequence
      set: col5
    - include: col_end
    - include: field_content_4

  col5:
    - match: ','
      scope: punctuation.separator.sequence
      set: col6
    - include: col_end
    - include: field_content_5

  col6:
    - match: ','
      scope: punctuation.separator.sequence
      set: col7
    - include: col_end
    - include: field_content_6

  col7:
    - match: ','
      scope: punctuation.separator.sequence
      set: col8
    - include: col_end
    - include: field_content_7

  col8:
    - match: ','
      scope: punctuation.separator.sequence
      set: col9
    - include: col_end
    - include: field_content_8

  col9:
    - match: ','
      scope: punctuation.separator.sequence
      set: col10
    - include: col_end
    - include: field_content_9

  col10:
    - match: ','
      scope: punctuation.separator.sequence
      set: col1
    - include: col_end
    - include: field_content_10

  col_end:
    - match: '\)\s*[,;]?'
      scope: punctuation.section.sequence.end
      pop: true
    - match: '$'
      pop: true

  # =============================================================
  # Field Content Parsers (with safe SQL '' escaping)
  # =============================================================

  field_content_1:
    - match: "'(?:''|[^'])*'"
      scope: markup.rainbow1.sil markup.rainbow1 markup.deleted.sil
    - match: '"(?:""|[^"])*"'
      scope: markup.rainbow1.sil markup.rainbow1 markup.deleted.sil
    - match: '[^,)\n\r]+'
      scope: markup.rainbow1.sil markup.rainbow1 markup.deleted.sil

  field_content_2:
    - match: "'(?:''|[^'])*'"
      scope: markup.rainbow2.sil markup.rainbow2 constant.numeric.sil
    - match: '"(?:""|[^"])*"'
      scope: markup.rainbow2.sil markup.rainbow2 constant.numeric.sil
    - match: '[^,)\n\r]+'
      scope: markup.rainbow2.sil markup.rainbow2 constant.numeric.sil

  field_content_3:
    - match: "'(?:''|[^'])*'"
      scope: markup.rainbow3.sil markup.rainbow3 markup.inserted.sil string.quoted.double.sil
    - match: '"(?:""|[^"])*"'
      scope: markup.rainbow3.sil markup.rainbow3 markup.inserted.sil string.quoted.double.sil
    - match: '[^,)\n\r]+'
      scope: markup.rainbow3.sil markup.rainbow3 markup.inserted.sil string.quoted.double.sil

  field_content_4:
    - match: "'(?:''|[^'])*'"
      scope: markup.rainbow4.sil markup.rainbow4 entity.name.function.sil
    - match: '"(?:""|[^"])*"'
      scope: markup.rainbow4.sil markup.rainbow4 entity.name.function.sil
    - match: '[^,)\n\r]+'
      scope: markup.rainbow4.sil markup.rainbow4 entity.name.function.sil

  field_content_5:
    - match: "'(?:''|[^'])*'"
      scope: markup.rainbow5.sil markup.rainbow5 keyword.control.sil
    - match: '"(?:""|[^"])*"'
      scope: markup.rainbow5.sil markup.rainbow5 keyword.control.sil
    - match: '[^,)\n\r]+'
      scope: markup.rainbow5.sil markup.rainbow5 keyword.control.sil

  field_content_6:
    - match: "'(?:''|[^'])*'"
      scope: markup.rainbow6.sil markup.rainbow6 variable.parameter.sil
    - match: '"(?:""|[^"])*"'
      scope: markup.rainbow6.sil markup.rainbow6 variable.parameter.sil
    - match: '[^,)\n\r]+'
      scope: markup.rainbow6.sil markup.rainbow6 variable.parameter.sil

  field_content_7:
    - match: "'(?:''|[^'])*'"
      scope: markup.rainbow7.sil markup.rainbow7 support.type.sil
    - match: '"(?:""|[^"])*"'
      scope: markup.rainbow7.sil markup.rainbow7 support.type.sil
    - match: '[^,)\n\r]+'
      scope: markup.rainbow7.sil markup.rainbow7 support.type.sil

  field_content_8:
    - match: "'(?:''|[^'])*'"
      scope: markup.rainbow8.sil markup.rainbow8 entity.other.attribute-name.sil
    - match: '"(?:""|[^"])*"'
      scope: markup.rainbow8.sil markup.rainbow8 entity.other.attribute-name.sil
    - match: '[^,)\n\r]+'
      scope: markup.rainbow8.sil markup.rainbow8 entity.other.attribute-name.sil

  field_content_9:
    - match: "'(?:''|[^'])*'"
      scope: markup.rainbow9.sil markup.rainbow9 string.quoted.single.sil
    - match: '"(?:""|[^"])*"'
      scope: markup.rainbow9.sil markup.rainbow9 string.quoted.single.sil
    - match: '[^,)\n\r]+'
      scope: markup.rainbow9.sil markup.rainbow9 string.quoted.single.sil

  field_content_10:
    - match: "'(?:''|[^'])*'"
      scope: markup.rainbow10.sil markup.rainbow10 punctuation.section.sil
    - match: '"(?:""|[^"])*"'
      scope: markup.rainbow10.sil markup.rainbow10 punctuation.section.sil
    - match: '[^,)\n\r]+'
      scope: markup.rainbow10.sil markup.rainbow10 punctuation.section.sil