[
    // =========================================================================
    // Rapscallion SIL Tools: Direct Legacy Shortcuts (Preserved)
    // =========================================================================
    {
        "keys": ["alt+q"],
        "command": "sil_sqlite_query"
    },
    {
        "keys": ["alt+f"],
        "command": "sil_column_frequency"
    },
    {
        "keys": ["alt+g"],
        "command": "sil_goto_column"
    },
    {
        "keys": ["alt+a"],
        "command": "sil_align_columns"
    },
    {
        "keys": ["super+alt+q"],
        "command": "sil_open_scratchpad"
    },
    {
        "keys": ["super+enter"],
        "command": "sil_execute_scratchpad",
        "context": [
            { "key": "setting.is_sil_scratchpad", "operator": "equal", "operand": true }
        ]
    },

    // =========================================================================
    // Rapscallion SIL Tools: Key Chords (Prefix: Super+Alt+S)
    // =========================================================================

    // Query SIL Table with SQLite: Super+Alt+S, Q
    {
        "keys": ["super+alt+s", "q"],
        "command": "sil_sqlite_query"
    },

    // Column Frequency Analysis: Super+Alt+S, F
    {
        "keys": ["super+alt+s", "f"],
        "command": "sil_column_frequency"
    },

    // Go to Column / Schema Inspector: Super+Alt+S, G
    {
        "keys": ["super+alt+s", "g"],
        "command": "sil_goto_column"
    },

    // Align Table Columns: Super+Alt+S, A
    {
        "keys": ["super+alt+s", "a"],
        "command": "sil_align_columns"
    },

    // Open SQL Query Scratchpad: Super+Alt+S, S
    {
        "keys": ["super+alt+s", "s"],
        "command": "sil_open_scratchpad"
    },

    // Query Presets & History: Super+Alt+S, P
    {
        "keys": ["super+alt+s", "p"],
        "command": "sil_query_presets"
    },

    // Toggle Result Format (CSV / Markdown): Super+Alt+S, R
    {
        "keys": ["super+alt+s", "r"],
        "command": "sil_toggle_result_format"
    },

    // Toggle Field Hover Inspector: Super+Alt+S, H
    {
        "keys": ["super+alt+s", "h"],
        "command": "sil_toggle_hover"
    },

    // Open SIL Documentation: Super+Alt+S, D
    {
        "keys": ["super+alt+s", "d"],
        "command": "sil_show_docs"
    }
]
