{
    // =========================================================================
    // Hover Inspection Tooltips
    // =========================================================================
    "hover_enabled": true,
    "hover_show_value": true,
    "hover_max_value_length": 80,

    // =========================================================================
    // Status Bar Feedback
    // =========================================================================
    // Show current column position and header name at the cursor position
    "status_bar_column_info": true,

    // =========================================================================
    // Rainbow Column Palette
    // =========================================================================
    // Curated 10-color high-contrast palette for columns 1 through 10.
    // Overrides default theme colors in hover tooltips and status indicators.
    "rainbow_column_colors": [
        "#FF5370", // Col 1: Coral Red
        "#FFD700", // Col 2: Bright Gold / Yellow
        "#50FA7B", // Col 3: Emerald Green
        "#38BDF8", // Col 4: Sky Blue
        "#BD93F9", // Col 5: Electric Purple
        "#FF9800", // Col 6: Tangerine Orange
        "#00E5FF", // Col 7: Bright Cyan
        "#FF79C6", // Col 8: Hot Pink / Magenta
        "#A3E635", // Col 9: Lime Green
        "#E2E8F0"  // Col 10: Platinum Silver
    ],

    // =========================================================================
    // Ingestion & Async Engine Options
    // =========================================================================
    // Parse files and initialize SQLite on a background worker thread
    "async_ingestion": true,

    // Batch size (rows) when inserting data into SQLite
    "ingestion_batch_size": 5000,

    // Number of sample rows inspected to infer SQLite data types (0 = all TEXT)
    "type_inference_sample_size": 100,

    // =========================================================================
    // Multi-Table SIL Dump Handling
    // =========================================================================
    // Behavior when multiple CREATE VIEW declarations are detected:
    //   "prompt"     - Shows a quick panel to pick the active table to query.
    //   "all_silent" - Ingests all tables and defaults the query panel to the first table.
    //   "first"      - Only parses the very first table found.
    "multi_table_behavior": "prompt",

    // =========================================================================
    // Query Execution & Result Format
    // =========================================================================
    // Output format for SQL queries and frequency distributions:
    //   "csv"      - Outputs to standard Results.csv (with Rainbow CSV coloring)
    //   "markdown" - Outputs to aligned GitHub-Flavored Markdown table Results.md
    "default_result_format": "csv",

    "default_query_template": "SELECT * FROM {table}",
    "export_delimiter": ",",
    "preferred_csv_syntax": "",

    // =========================================================================
    // Column Formatter & Alignment
    // =========================================================================
    // Maximum character width for any single column when aligning (0 = unlimited)
    "align_max_col_width": 120
}